# ---------------------------------------------------------------------------
# Cấu hình PRODUCTION — copy thành .env trên máy chủ rồi điền.
#
#   cp .env.prod.example .env && chmod 600 .env && vi .env
#
# Mọi dòng ghi "BẮT BUỘC" phải thay giá trị. Số còn lại đã tinh chỉnh sẵn cho
# máy 2 vCPU / 2GB RAM — xem deploy-plan.md nếu muốn biết vì sao từng con số.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Tên miền
# ---------------------------------------------------------------------------
# BẮT BUỘC. Tên miền đã trỏ A (và AAAA nếu dùng IPv6) về IP máy chủ. Chưa có
# tên miền riêng thì dùng sslip.io: 103-121-89-215.sslip.io — vẫn xin được
# chứng chỉ Let's Encrypt thật.
SITE_DOMAIN=
# Email nhận cảnh báo chứng chỉ từ Let's Encrypt. Để trống vẫn chạy.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info
DEFAULT_LANGUAGE=auto
# A = tách audio gốc, B = TTS đọc nguyên văn, C = LLM viết lại rồi TTS đọc.
# Mode C tự bị tắt nếu LLM_PROVIDER còn là mock (xem mục AI providers).
ENABLED_COLLECT_MODES=A,B,C

# ---------------------------------------------------------------------------
# Postgres — chỉ nghe trong mạng nội bộ docker, không mở cổng ra ngoài
# ---------------------------------------------------------------------------
POSTGRES_USER=voice
# BẮT BUỘC. Sinh mật khẩu: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=voice_tool
# BẮT BUỘC. Mật khẩu ở đây phải TRÙNG với POSTGRES_PASSWORD bên trên —
# scripts/deploy.sh có kiểm tra, nhưng sai là api không kết nối được.
DATABASE_URL=postgres://voice:MAT_KHAU_O_TREN@postgres:5432/voice_tool?sslmode=disable
# 3 process (api + worker + scheduler) × 8 = 24 < max_connections=30 của
# Postgres. Tăng số này thì phải tăng cả max_connections trong compose.
DB_MAX_CONNS=8

# ---------------------------------------------------------------------------
# Redis / Asynq
# ---------------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
# Số task song song TRONG 1 worker. 2 vì task nặng nhất (yt-dlp + ffmpeg) ăn
# trọn 1 vCPU, và 3voices cũng chỉ cho 2 job đồng thời mỗi tài khoản.
WORKER_CONCURRENCY=2
# 1 process worker. Máy 2 vCPU không chạy nổi nhiều hơn; mọi task đều idempotent
# nên tăng thoải mái khi lên máy lớn.
WORKER_REPLICAS=1

# ---------------------------------------------------------------------------
# Tham số quét
# ---------------------------------------------------------------------------
BREAKING_SCAN_INTERVAL=60s
SCAN_LIMIT_DEFAULT=20
MAX_POSTS_PER_RUN_DEFAULT=50
# 2 kênh quét song song (dev là 4) — mỗi lần quét là 1 tiến trình yt-dlp.
BREAKING_SCAN_PARALLELISM=2
SCHEDULER_SYNC_INTERVAL=30s
SKIPPED_LOG_RETENTION=168h
# Han muc goi TTS tinh TREN MOI API KEY (3voices: 10 request/phut, 2 job dong
# thoi). 6s x 10 = dung 10 request/phut.
TTS_MIN_GAP=6s
TTS_MAX_CONCURRENT=2
# Giu ban ghi luong dung AI 90 ngay (man Cai dat > Chi phi AI).
AI_USAGE_RETENTION=2160h
# Giu lich su quet (scan_run) 30 ngay - tab Lich su quet cua tung kenh.
SCAN_RUN_RETENTION=720h
# ---------------------------------------------------------------------------
# Hạ tầng via/proxy quét kênh Facebook / X / Instagram
# ---------------------------------------------------------------------------
# Ba nền tảng này không liệt kê được bài của một trang qua yt-dlp, và kênh nguồn
# là trang CÔNG KHAI CỦA NGƯỜI KHÁC nên không dùng được API chính thức. Cách còn
# lại là đọc bằng phiên đăng nhập (via) + proxy.
#
# RỦI RO: cách làm này vi phạm điều khoản sử dụng của cả ba nền tảng, mang rủi ro
# pháp lý về scraping, và chi phí thật là via chết liên tục phải thay. Giữ hạ
# tầng này TÁCH BIỆT hoàn toàn với Business account dùng để đăng bài.
#
# Via và proxy quản lý trên giao diện (Cài đặt), không khai ở đây.

# Bao nhiêu lỗi "đòi đăng nhập" LIÊN TIẾP thì via vào nghỉ. 3 chứ không phải 1:
# một lỗi lẻ có thể do chính bài đó bị giới hạn, và cất via đi vì nó là vứt một
# tài khoản còn tốt.
VIA_LOGIN_ERROR_THRESHOLD=3
# Via nghỉ bao lâu rồi được thử lại. Nghỉ xong vẫn hỏng thì coi như đã chết.
VIA_COOLDOWN=6h
# Bao nhiêu lần bị chặn IP LIÊN TIẾP thì proxy bị hạ cấp. Proxy KHÔNG tự hồi
# sinh: một IP đã bị Meta/X liệt thì chờ cũng không khỏi.
PROXY_BLOCK_THRESHOLD=3
# Giữ nhật ký dùng via 30 ngày — đủ để nhìn ra một via đang xấu dần.
VIA_USAGE_LOG_RETENTION=720h
# Số kênh quét đồng thời TRÊN MỖI nền tảng, và khoảng nghỉ giữa 2 request. Thấp
# là cố ý: vài trăm kênh quét 1 lần/ngày không cần nhanh, mà mỗi request song
# song thêm là một lần nữa cùng dải hạ tầng xuất hiện trước mặt nền tảng.
SCRAPE_CONCURRENCY=3
SCRAPE_MIN_GAP=5s
# CÔNG TẮC NGẮT cho việc quét kênh của ba nền tảng chạy bằng via. Mặc định BẬT.
#
# Ba bộ phân tích bám vào cấu trúc nội bộ của ba nền tảng — không tài liệu,
# không cam kết tương thích — nên chúng hỏng độc lập nhau. Nền tảng nào đổi giao
# diện thì đặt cờ của RIÊNG nó về false rồi khởi động lại: kênh của nền tảng đó
# ngừng quét, hai nền tảng còn lại không bị đụng tới.
FACEBOOK_CHANNEL_SCAN=true
INSTAGRAM_CHANNEL_SCAN=true
X_CHANNEL_SCAN=true


# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# BẮT BUỘC. Sinh: head -c 32 /dev/urandom | xxd -p -c 64
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# BẮT BUỘC. Sinh: head -c 32 /dev/urandom | base64
#
# LƯU KHOÁ NÀY VÀO PASSWORD MANAGER NGAY. Nó mã hoá token multime và API key
# TTS của mọi người dùng; mất khoá là toàn bộ số đó không giải mã được nữa,
# ai cũng phải đăng nhập lại và khai lại key.
TOKEN_ENCRYPTION_KEY=

# Role của tài khoản đăng nhập lần đầu: admin | editor | user
DEFAULT_USER_ROLE=user
# BẮT BUỘC. Email này luôn được nâng lên admin khi đăng nhập — không có nó thì
# không ai cấp quyền được cho ai.
BOOTSTRAP_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Object storage
#
# Mặc định dưới đây dùng MinIO chạy cùng máy (tự chứa, deploy được ngay).
# Có S3 thật thì đổi 4 dòng S3_* và xoá service minio trong
# docker-compose.prod.yml — tiết kiệm ~250MB RAM.
#
#   S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
#   S3_REGION=ap-southeast-1
#   S3_BUCKET=strongbody-files-api
#   S3_USE_PATH_STYLE=false
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=voice-tool
# BẮT BUỘC đổi (đây cũng là user/pass của MinIO): openssl rand -hex 16
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# TTS thật. API key KHÔNG khai ở đây mà khai theo từng người ở màn "AI Engine"
# trên web: worker đọc bằng key của chính người tạo voice nên quota và hoá đơn
# 3voices về đúng người đó.
TTS_PROVIDER=3voices
THREEVOICES_API_KEY=
THREEVOICES_BASE_URL=https://3voices.win
# Để trống = dùng /tts/design (giọng nữ, trẻ, cao độ vừa). Muốn giọng cố định
# giữa mọi voice thì lưu giọng bên 3voices rồi điền voice_id vào đây.
THREEVOICES_VOICE_ID=

# STT chỉ dùng khi bài không có phụ đề. mock trả chuỗi giả — đặt openai +
# OPENAI_API_KEY nếu cần nghe audio để lấy chữ.
STT_PROVIDER=mock
OPENAI_API_KEY=

# LLM là bước "viết lại theo Prompt mẫu" của hình thức C. Còn là mock thì hệ
# thống TỰ TẮT hình thức C kèm lý do (mock không viết lại được gì).
# Muốn dùng C: LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Binary worker gọi (đã cài sẵn trong image worker)
# ---------------------------------------------------------------------------
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Proxy cho yt-dlp — BAT KHI CAN, khong bat san.
#   YTDLP_PROXY ap cho moi nen tang; bien theo tung nen tang ghi de len no.
#   Dinh dang: http://user:pass@host:port hoac socks5://host:port
#
#   Khi nao can: man Cai dat co bang "So lan bi nen tang chan". Con so cua mot
#   nen tang tang deu moi ngay nghia la IP may chu da bi nhan dien -> bat proxy
#   cho DUNG nen tang do. Day cang YouTube (luong duy nhat dang chay tot) qua
#   proxy la tu them mot diem hong.
YTDLP_PROXY=
YTDLP_PROXY_YOUTUBE=
YTDLP_PROXY_FACEBOOK=
YTDLP_PROXY_TIKTOK=
YTDLP_PROXY_INSTAGRAM=
YTDLP_PROXY_X=

# ---------------------------------------------------------------------------
# multime.ai — vừa là nơi đăng nhập, vừa là đích publish
# ---------------------------------------------------------------------------
MULTIME_BASE_URL=https://voice-api.strongbody.ai
MULTIME_AUTH_BASE_URL=https://api-v2.strongbody.ai
MULTIME_SITE_URL=https://multime.ai
MULTIME_VISIBILITY=public
MULTIME_PUBLIC_DOWNLOAD=false
# multime bắt mỗi bài đăng có ít nhất 1 hashtag. Không còn hashtag mặc định:
# Voice bỏ trống hashtag thì hệ thống không cho đăng.
MULTIME_CATEGORY_IDS=

# ---------------------------------------------------------------------------
# Frontend
#
# KHÔNG đặt NEXT_PUBLIC_API_URL ở đây: nó là biến BUILD-TIME, được nướng vào
# bundle JS lúc build image (docker-compose.prod.yml đã truyền chuỗi rỗng để
# frontend gọi /api/v1 tương đối). Đặt ở đây không có tác dụng gì.
# ---------------------------------------------------------------------------

# Tag của image đang chạy. `prod` tách khỏi tag `latest` của bản dev — hai bản
# build frontend khác nhau (dev trỏ localhost:8080). Đặt theo git sha khi cần
# quay lui nhanh: IMAGE_TAG=$(git rev-parse --short HEAD).
IMAGE_TAG=prod
