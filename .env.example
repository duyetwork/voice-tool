# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
# auto = để nền tảng nguồn / multime.ai tự nhận diện ngôn ngữ.
DEFAULT_LANGUAGE=auto
# Hình thức thu thập đang bật (A = extract audio gốc, B = TTS đọc nguyên văn,
# C = LLM viết lại rồi TTS đọc). Mode C cần LLM thật — hoặc một Bộ API key khai
# trong DB (mục AI Engine > LLM Model), hoặc LLM_PROVIDER + key ở dưới.
ENABLED_COLLECT_MODES=A,B,C

# ---------------------------------------------------------------------------
# Postgres — docker-compose dùng các biến POSTGRES_* để tạo container
# ---------------------------------------------------------------------------
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice
POSTGRES_DB=voice_tool
POSTGRES_PORT=5432
# Chạy trong docker: host là "postgres". Chạy local (go run): đổi thành localhost.
DATABASE_URL=postgres://voice:voice@postgres:5432/voice_tool?sslmode=disable
DB_MAX_CONNS=10

# ---------------------------------------------------------------------------
# Redis / Asynq
# ---------------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
# Số task chạy song song trong 1 process worker.
WORKER_CONCURRENCY=10
# Số process worker (docker compose). Scheduler luôn là 1 process.
WORKER_REPLICAS=2

# ---------------------------------------------------------------------------
# Tham số quét — giá trị dưới đây là chỉ số tối ưu gợi ý, chỉnh được theo
# từng kênh trên UI (để trống ở kênh = dùng giá trị này).
# ---------------------------------------------------------------------------
# Khoảng nghỉ giữa 2 vòng quét Breaking. 60s đủ nhanh cho "breaking" mà không
# đụng rate-limit nền tảng.
BREAKING_SCAN_INTERVAL=60s
# Số bài lấy về mỗi vòng quét: bắt kịp kênh đăng dày, không tốn quota vô ích.
SCAN_LIMIT_DEFAULT=20
# Trần Bài Post tạo ra trong 1 vòng quét — chặn nổ chi phí AI khi kênh đăng ồ ạt.
# 0 = không giới hạn (mặc định): lấy hết bài mới trong cửa sổ quét. Đặt số > 0
# khi muốn mọi kênh chưa cấu hình riêng đều bị chặn trần.
MAX_POSTS_PER_RUN_DEFAULT=0
# Số kênh Breaking quét song song trong 1 vòng dispatch.
BREAKING_SCAN_PARALLELISM=4
# Chu kỳ scheduler đọc lại cấu hình lịch từ DB (sửa scan_frequency có hiệu lực
# sau khoảng thời gian này).
SCHEDULER_SYNC_INTERVAL=30s
# Giữ skipped_log 7 ngày — đây là dữ liệu debug regex, không phải audit trail.
SKIPPED_LOG_RETENTION=168h
# Khoảng nghỉ tối thiểu giữa 2 lần gọi yt-dlp tới CÙNG một nền tảng, và mỗi nền
# tảng chỉ 1 lần tải chạy cùng lúc. N kênh cùng tần suất mà bắn cùng một giây là
# đúng cái kích hoạt bot-check của YouTube và 429 của Facebook.
PLATFORM_MIN_GAP=3s
# Hạn mức gọi TTS, tính TRÊN MỖI API KEY (3voices: 10 request/phút, 2 job đồng
# thời). Key khai theo từng người nên tải đã chia sẵn, nhưng 1 người chạy hàng
# loạt vẫn dồn được 20 task song song vào đúng 1 key.
#   6s × 10 = 60s -> đúng 10 request/phút.
TTS_MIN_GAP=6s
TTS_MAX_CONCURRENT=2
# Giữ bản ghi lượng dùng AI 90 ngày — đủ để so quý này với quý trước, đủ ngắn
# để bảng không phình mãi. Xem màn Cài đặt > Chi phí AI.
AI_USAGE_RETENTION=2160h
# Giữ lịch sử quét (scan_run) 30 ngày — đủ để nhìn nhịp chạy của một kênh: nó im
# từ bao giờ, trước đó có ra bài không. Kênh Breaking quét mỗi phút là ~43k dòng
# một tháng cho MỖI kênh, nên vẫn phải dọn.
SCAN_RUN_RETENTION=720h
# ---------------------------------------------------------------------------
# Hạ tầng via/proxy quét kênh Facebook / X / Instagram
# ---------------------------------------------------------------------------
# Ba nền tảng này không liệt kê được bài của một trang qua yt-dlp, và kênh nguồn
# là trang CÔNG KHAI CỦA NGƯỜI KHÁC nên không dùng được API chính thức. Cách còn
# lại là đọc bằng phiên đăng nhập (via) + proxy.
#
# RỦI RO: cách làm này vi phạm điều khoản sử dụng của cả ba nền tảng, mang rủi ro
# pháp lý về scraping, và chi phí thật là via chết liên tục phải thay. Giữ hạ
# tầng này TÁCH BIỆT hoàn toàn với Business account dùng để đăng bài.
#
# Via và proxy quản lý trên giao diện (Cài đặt), không khai ở đây.

# Bao nhiêu lỗi "đòi đăng nhập" LIÊN TIẾP thì via vào nghỉ. 3 chứ không phải 1:
# một lỗi lẻ có thể do chính bài đó bị giới hạn, và cất via đi vì nó là vứt một
# tài khoản còn tốt.
VIA_LOGIN_ERROR_THRESHOLD=3
# Via nghỉ bao lâu rồi được thử lại. Nghỉ xong vẫn hỏng thì coi như đã chết.
VIA_COOLDOWN=6h
# Bao nhiêu lần bị chặn IP LIÊN TIẾP thì proxy bị hạ cấp. Proxy KHÔNG tự hồi
# sinh: một IP đã bị Meta/X liệt thì chờ cũng không khỏi.
PROXY_BLOCK_THRESHOLD=3
# Giữ nhật ký dùng via 30 ngày — đủ để nhìn ra một via đang xấu dần.
VIA_USAGE_LOG_RETENTION=720h
# Số kênh quét đồng thời TRÊN MỖI nền tảng, và khoảng nghỉ giữa 2 request. Thấp
# là cố ý: vài trăm kênh quét 1 lần/ngày không cần nhanh, mà mỗi request song
# song thêm là một lần nữa cùng dải hạ tầng xuất hiện trước mặt nền tảng.
SCRAPE_CONCURRENCY=3
SCRAPE_MIN_GAP=5s
# Mở khoá việc THÊM KÊNH Facebook. Để false cho tới khi đã thử via thật trên một
# trang thật: bộ phân tích bám vào cấu trúc JSON nội bộ của Facebook, không có
# tài liệu và không có cam kết tương thích.
FACEBOOK_CHANNEL_SCAN=false


# ---------------------------------------------------------------------------
# Auth — BẮT BUỘC đổi trước khi lên production
#
# Hệ thống KHÔNG có đăng ký và KHÔNG lưu mật khẩu: đăng nhập bằng tài khoản
# strongbody/multime, và chính tài khoản đó là tài khoản voice được đăng lên.
# ---------------------------------------------------------------------------
# Chuỗi ngẫu nhiên bất kỳ, đủ dài. Bỏ trống thì api không khởi động được.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Khoá AES-256 (base64 32 byte) mã hoá token multime của user lưu trong DB.
# BẮT BUỘC sinh khoá riêng: `make gen-key`. Thiếu hoặc sai định dạng thì api
# và worker fail-fast ngay khi khởi động — có chủ ý, để không chạy với khoá rác.
# Đổi khoá làm token đang lưu không giải mã được, user phải đăng nhập lại
# (dữ liệu khác không ảnh hưởng).
TOKEN_ENCRYPTION_KEY=

# Role của tài khoản đăng nhập LẦN ĐẦU: admin | editor | user
#   user   — xem tất cả + tạo/chạy/đăng voice, KHÔNG được xoá
#   editor — toàn quyền nghiệp vụ (kể cả xoá), TRỪ cấp quyền
#   admin  — toàn quyền, kể cả cấp quyền
DEFAULT_USER_ROLE=user

# Email này luôn được cấp quyền admin khi đăng nhập (vẫn dùng mật khẩu
# strongbody của họ, hệ thống không có mật khẩu riêng).
BOOTSTRAP_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Object storage (MinIO cho dev / AWS S3 cho production)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=voice-tool
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
# Để trống thì URL file được sinh từ S3_ENDPOINT.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# AI providers
#   mock = chạy được ngay không cần API key (dev)
#   TTS_PROVIDER: mock | 3voices
#   STT_PROVIDER: mock | openai
#   LLM_PROVIDER: mock | gemini | openai | anthropic
#     ĐÂY CHỈ LÀ ĐƯỜNG DỰ PHÒNG CHO DEV. Production dùng "Bộ API key" khai ở
#     màn AI Engine > LLM Model: mỗi bộ là túi key của nhiều nhà, và router tự
#     chuyển dự phòng theo chuỗi cấu hình trong mục Cài đặt khi một nhà hết hạn
#     mức. Voice nào không gắn bộ mới rơi về provider khai ở đây.
#
#     mock KHÔNG viết lại gì (trả nguyên text nguồn) -> hệ thống tự TẮT hình
#     thức C khi provider còn là mock VÀ trong DB chưa có key LLM nào.
# ---------------------------------------------------------------------------
TTS_PROVIDER=mock
STT_PROVIDER=mock
LLM_PROVIDER=mock

# 3voices.win — nhà cung cấp TTS duy nhất (https://3voices.win/docs/api).
#
# API key GIỜ KHAI THEO TỪNG NGƯỜI ở màn "AI Engine" trên web, không phải ở
# đây: worker chạy TTS bằng key của chính người tạo voice nên quota/chi phí về
# đúng người đó. 3 biến dưới chỉ là dự phòng chung, để trống là hợp lệ —
# ai chưa khai key sẽ nhận lỗi kèm hướng dẫn thay vì chạy nhờ key người khác.
#
# Để trống THREEVOICES_VOICE_ID thì dùng /tts/design (sinh giọng theo mô tả);
# có voice_id thì dùng /tts/saved (giọng đã lưu trong tài khoản).
THREEVOICES_API_KEY=
THREEVOICES_BASE_URL=https://3voices.win
THREEVOICES_VOICE_ID=

# Key LLM dự phòng (dev). Model ghim ID ĐẦY ĐỦ, không dùng alias: alias
# `gpt-5.6` không trỏ về Luna mà trỏ về Sol, đắt hơn khoảng 25 lần, và không có
# lỗi nào hiện ra — chỉ có hoá đơn đội lên.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Binary ngoài mà worker gọi
#   YouTube dùng yt-dlp nên không cần API key. Nền tảng khác (Facebook, X,
#   TikTok, Instagram) sẽ tự khai credential của nó khi có adapter.
# ---------------------------------------------------------------------------
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Proxy cho yt-dlp — BAT KHI CAN, khong bat san.
#   YTDLP_PROXY ap cho moi nen tang; bien theo tung nen tang ghi de len no.
#   Dinh dang: http://user:pass@host:port hoac socks5://host:port
#
#   Khi nao can: man Cai dat co bang "So lan bi nen tang chan". Con so cua mot
#   nen tang tang deu moi ngay nghia la IP may chu da bi nhan dien -> bat proxy
#   cho DUNG nen tang do. Day cang YouTube (luong duy nhat dang chay tot) qua
#   proxy la tu them mot diem hong.
YTDLP_PROXY=
YTDLP_PROXY_YOUTUBE=
YTDLP_PROXY_FACEBOOK=
YTDLP_PROXY_TIKTOK=
YTDLP_PROXY_INSTAGRAM=
YTDLP_PROXY_X=

# ---------------------------------------------------------------------------
# multime.ai — vừa là nơi đăng nhập, vừa là đích publish
#
# Hợp đồng API lấy từ repo multime-ai (trang /studio/upload):
#   POST {MULTIME_AUTH_BASE_URL}/v1/public/auth/login      -> accessToken + refreshToken + user id
#   GET  {MULTIME_AUTH_BASE_URL}/v1/admin/auth/refresh-token -> accessToken mới
#   POST {MULTIME_BASE_URL}/v1/seller/voice-posts/upload   -> upload audio + tạo bài
#                                                             đăng trong 1 request
#
# Không có tài khoản hệ thống dùng chung: voice được đăng bằng token của chính
# user đã tạo ra nó. Để trống MULTIME_BASE_URL thì dùng mock (đăng nhập bằng
# email bất kỳ + mật khẩu >= 6 ký tự) để dev chạy đầu-cuối.
# ---------------------------------------------------------------------------
MULTIME_BASE_URL=https://voice-api.strongbody.ai
MULTIME_AUTH_BASE_URL=https://api-v2.strongbody.ai
MULTIME_SITE_URL=https://multime.ai

# Mặc định cho bài đăng.
MULTIME_VISIBILITY=public
MULTIME_PUBLIC_DOWNLOAD=false
# multime yêu cầu MỖI bài đăng có ít nhất 1 hashtag. Không còn hashtag mặc
# định: mỗi Voice phải có hashtag của riêng nó, bỏ trống thì không đăng được.
# Danh sách category id, phân tách bằng dấu phẩy (để trống nếu chỉ dùng hashtag).
MULTIME_CATEGORY_IDS=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
# Bien BUILD-TIME: Next.js nuong thang vao bundle JS luc build, sua xong phai
# build lai frontend (docker compose up -d --build frontend).
#   - De trong: frontend goi API bang duong dan tuong doi /api/v1 -> dung khi ca
#     hai dung sau cung 1 reverse proxy / 1 ten mien (cach deploy production).
#   - Chay local 2 cong rieng: dien URL tuyet doi nhu duoi.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Công cụ quan sát khi dev (chỉ chạy trong docker compose)
# ---------------------------------------------------------------------------
# Adminer — xem/sửa database qua web
ADMINER_PORT=8085
